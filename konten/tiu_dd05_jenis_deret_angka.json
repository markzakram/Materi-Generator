          "blok": [
            {
              "jenis": "subjudul",
              "teks": "Contoh",
              "tingkat": 2
            },
            {
              "jenis": "sorot",
              "teks": "$3,11,...,29,...,55,69$"
            },
            {
              "jenis": "sorot",
              "teks": "$U₁=(1×4)−1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=3$"
            },
            {
              "jenis": "sorot",
              "teks": "$U₂=(2×5)+1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=11$"
            },
            {
              "jenis": "sorot",
              "teks": "$U₃=(3×6)−1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=17$"
            },
            {
              "jenis": "sorot",
              "teks": "$U₄=(4×7)+1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=29$"
            },
            {
              "jenis": "sorot",
              "teks": "$U₅=(5×8)−1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=39$"
            },
            {
              "jenis": "sorot",
              "teks": "$U₆=(6×9)+1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=55$"
            },
            {
              "jenis": "sorot",
              "teks": "$U₇=(7×10)−1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=69$"
            },
            {
              "jenis": "sorot",
              "teks": "$U(n)=[n(n+3)]∓1$"
            },
            {
              "jenis": "paragraf",
              "teks": "dengan (−) untuk suku ganjil dan (+) untuk suku genap."
            },
