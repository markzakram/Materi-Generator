            {
              "jenis": "sorot",
              "teks": "$Biaya=150.000$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, jumlah yang dibayar Rp150.000. Perhitungan memakai harga paket dan jumlah buah yang diterima. Jawaban B."
