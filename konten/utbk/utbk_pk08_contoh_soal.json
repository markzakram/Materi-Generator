          "judul": "Contoh Soal 5 — Median Lima Nilai",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Lima bilangan berbeda tersusun dari yang terkecil ke terbesar, yaitu **p, 11, r, s, dan t**, dengan **s = r + 3**."
            },
            {
              "jenis": "paragraf",
              "teks": "Apakah median kelima bilangan tersebut lebih dari **17**?"
            },
            {
              "jenis": "paragraf",
              "teks": "(1) Rata-rata kelima bilangan adalah **18**."
            },
            {
              "jenis": "paragraf",
              "teks": "(2) **t − p = 18**."
            }
          ],
          "opsi": {
            "A": "Pernyataan (1) saja cukup, tetapi pernyataan (2) saja tidak cukup.",
            "B": "Pernyataan (2) saja cukup, tetapi pernyataan (1) saja tidak cukup.",
            "C": "Kedua pernyataan bersama-sama cukup, tetapi masing-masing tidak cukup.",
            "D": "Masing-masing pernyataan cukup untuk menjawab pertanyaan.",
            "E": "Kedua pernyataan bersama-sama tidak cukup untuk menjawab pertanyaan."
          },
          "kunci": "C",
          "pembahasan": [
            {
              "jenis": "subjudul",
              "teks": "Konsep",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Karena lima bilangan sudah diurutkan:"
            },
            {
              "jenis": "paragraf",
              "teks": "p < 11 < r < s < t"
            },
            {
              "jenis": "paragraf",
              "teks": "maka median adalah bilangan ketiga, yaitu:"
            },
            {
              "jenis": "paragraf",
              "teks": "Median = r"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi pertanyaan sebenarnya adalah:"
            },
            {
              "jenis": "paragraf",
              "teks": "Apakah r > 17?"
            },
            {
              "jenis": "paragraf",
              "teks": "Diketahui juga:"
            },
            {
              "jenis": "paragraf",
              "teks": "s = r + 3"
            },
            {
              "jenis": "subjudul",
              "teks": "Pernyataan (1): Rata-rata kelima bilangan adalah 18.",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Jumlah kelima bilangan:"
            },
            {
              "jenis": "paragraf",
              "teks": "5 × 18 = 90"
            },
            {
              "jenis": "paragraf",
              "teks": "Maka:"
            },
            {
              "jenis": "paragraf",
              "teks": "p + 11 + r + s + t = 90"
            },
            {
              "jenis": "paragraf",
              "teks": "Substitusi s = r + 3:"
            },
            {
              "jenis": "paragraf",
              "teks": "p + 11 + r + r + 3 + t = 90"
            },
            {
              "jenis": "paragraf",
              "teks": "p + t + 2r = 76"
            },
            {
              "jenis": "paragraf",
              "teks": "Persamaan ini belum menentukan nilai r secara pasti."
            },
            {
              "jenis": "paragraf",
              "teks": "Contohnya, r dapat bernilai 17 maupun lebih dari 17 dengan nilai p dan t yang berbeda."
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, pernyataan (1) saja tidak cukup."
            },
            {
              "jenis": "sorot",
              "teks": "Pernyataan (2): t − p = 18."
            },
            {
              "jenis": "paragraf",
              "teks": "Diperoleh:"
            },
            {
              "jenis": "paragraf",
              "teks": "t = p + 18"
            },
            {
              "jenis": "paragraf",
              "teks": "Informasi ini hanya menunjukkan hubungan antara bilangan terkecil dan terbesar. Nilai r masih dapat berubah."
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, pernyataan (2) saja tidak cukup."
            },
            {
              "jenis": "subjudul",
              "teks": "Gabungkan pernyataan (1) dan (2).",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Dari (1):"
            },
            {
              "jenis": "paragraf",
              "teks": "p + t + 2r = 76"
            },
            {
              "jenis": "paragraf",
              "teks": "Dari (2):"
            },
            {
              "jenis": "paragraf",
              "teks": "t = p + 18"
            },
            {
              "jenis": "paragraf",
              "teks": "Substitusi:"
            },
            {
              "jenis": "paragraf",
              "teks": "p + (p + 18) + 2r = 76"
            },
            {
              "jenis": "paragraf",
              "teks": "2p + 2r = 58"
            },
            {
              "jenis": "paragraf",
              "teks": "p + r = 29"
            },
            {
              "jenis": "paragraf",
              "teks": "Sehingga:"
            },
            {
              "jenis": "paragraf",
              "teks": "r = 29 − p"
            },
            {
              "jenis": "paragraf",
              "teks": "Karena urutan bilangan menunjukkan:"
            },
            {
              "jenis": "paragraf",
              "teks": "p < 11"
            },
            {
              "jenis": "paragraf",
              "teks": "maka:"
            },
            {
              "jenis": "paragraf",
              "teks": "r = 29 − p > 29 − 11"
            },
            {
              "jenis": "paragraf",
              "teks": "r > 18"
            },
            {
              "jenis": "paragraf",
              "teks": "Dengan demikian, pasti berlaku:"
            },
            {
              "jenis": "paragraf",
              "teks": "r > 17"
            },
            {
              "jenis": "paragraf",
              "teks": "Karena median = r, maka median pasti lebih dari 17."
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, kedua pernyataan harus digunakan bersama-sama."
            },
            {
              "jenis": "paragraf",
              "teks": "**Jawaban: C.**"
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Median = r."
            },
            {
              "jenis": "paragraf",
              "teks": "Dari (1):"
            },
            {
              "jenis": "paragraf",
              "teks": "p + t + 2r = 76"
            },
            {
              "jenis": "paragraf",
              "teks": "Dari (2):"
            },
            {
              "jenis": "paragraf",
              "teks": "t = p + 18"
            },
            {
              "jenis": "paragraf",
              "teks": "Gabungkan:"
            },
            {
              "jenis": "paragraf",
              "teks": "p + (p + 18) + 2r = 76"
            },
            {
              "jenis": "paragraf",
              "teks": "p + r = 29"
            },
            {
              "jenis": "paragraf",
              "teks": "Karena p < 11:"
            },
            {
              "jenis": "paragraf",
              "teks": "r > 18"
            },
            {
              "jenis": "paragraf",
              "teks": "Maka median pasti lebih dari 17. **Jadi jawabannya C.**"
            }
          ],
          "label": "Kecukupan Data"
        },
