          "judul": "Contoh Soal 7 — Waktu Produksi Dua Jenis Patung",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Pembuatan 2 patung gajah dan 3 patung banteng memerlukan 8 jam. Pembuatan 1 patung gajah dan 2 patung banteng memerlukan 5 jam. Berapa jam untuk 4 patung gajah dan 1 patung banteng?"
            },
            {
              "jenis": "gambar",
              "file": "media/utbk_pk08_penalaran_kuantitatif/gambar-11.png",
              "lebar": 8.02,
              "tinggi": 2.21
            }
          ],
          "opsi": {
            "A": "4 jam",
            "B": "5 jam",
            "C": "6 jam",
            "D": "7 jam",
            "E": "8 jam"
          },
          "kunci": "C",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "**Konsep:** Model sistem persamaan linear dengan waktu per unit konstan."
            },
            {
              "jenis": "paragraf",
              "teks": "Misalkan g jam untuk 1 gajah dan b jam untuk 1 banteng."
            },
            {
              "jenis": "paragraf",
              "teks": "Model: 2g+3b=8"
            },
            {
              "jenis": "paragraf",
              "teks": "serta g+2b=5."
            },
            {
              "jenis": "paragraf",
              "teks": "Substitusi g=5−2b ke persamaan pertama memberi"
            },
            {
              "jenis": "paragraf",
              "teks": "10−4b+3b=8"
            },
            {
              "jenis": "paragraf",
              "teks": "⇒ b=2 dan g=1."
            },
            {
              "jenis": "paragraf",
              "teks": "Maka 4g+b = 4+2 = 6 jam."
            },
            {
              "jenis": "paragraf",
              "teks": "**Analisis Pilihan A–E:** A, B, D, E tidak memenuhi kedua hubungan waktu; C tepat."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Eliminasi: gandakan persamaan kedua ⇒ 2g+4b=10; kurangi persamaan pertama ⇒ b=2; lalu g=1."
            }
          ],
          "label": "Soal Cerita"
        },
