              "jenis": "paragraf",
              "teks": "B. 45 bukan hasil."
            },
            {
              "jenis": "paragraf",
              "teks": "C. Benar: $360 ÷ 6 = 60.$"
            },
            {
              "jenis": "paragraf",
              "teks": "D. 90 bukan hasil."
            },
            {
              "jenis": "paragraf",
              "teks": "E. 120 bukan hasil."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Catat eksponen maksimum dan minimum per prima dalam dua baris, kemudian bagi hasilnya."
            }
