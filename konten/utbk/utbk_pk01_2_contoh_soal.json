            {
              "jenis": "sorot",
              "teks": "$FPB = 2¹ × 3¹ = 6.$"
            },
            {
              "jenis": "paragraf",
              "teks": "$KPK = 2³ × 3² × 5 = 360$."
            },
            {
              "jenis": "paragraf",
              "teks": "Maka $KPK ÷ FPB = 360 ÷ 6 = 60$."
            },
