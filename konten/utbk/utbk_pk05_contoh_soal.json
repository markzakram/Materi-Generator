          "judul": "Contoh Soal 16 — Memilih Rasio yang Tepat",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Sebuah pengamat berjarak mendatar $12 m$ dari kaki tiang vertikal. Garis pandangnya ke puncak tiang membentuk sudut elevasi $θ$, dengan $tan θ = 5/12$. Berapa tinggi tiang, jika tinggi mata pengamat dianggap $0 m$?"
            },
            {
              "jenis": "gambar",
              "file": "media/utbk_pk05_geometri_dan_pengukuran/gambar-11.png",
              "lebar": 4.39,
              "tinggi": 2.47
            }
          ],
          "opsi": {
            "A": "5 m",
            "B": "7 m",
            "C": "12 m",
            "D": "13 m",
            "E": "17 m"
          },
          "kunci": "A",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "**Konsep:** Tangen pada segitiga siku-siku menyatakan perbandingan sisi depan sudut terhadap sisi samping sudut."
            },
            {
              "jenis": "paragraf",
              "teks": "Terhadap sudut $θ$ di posisi pengamat, sisi depan adalah tinggi tiang $h$ dan sisi samping merupakan jarak mendatar $12 m.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi $tan θ =h/12 =5/12$"
            },
            {
              "jenis": "paragraf",
              "teks": "sehingga $h = 5 m.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Panjang garis pandang adalah $13 m$ (Pythagoras), tetapi bukan tinggi tiang."
            },
            {
              "jenis": "paragraf",
              "teks": "Penggunaan sinus atau kosinus tanpa membedakan sisi sering menghasilkan hasil yang salah."
            },
            {
              "jenis": "subjudul",
              "teks": "Analisis pilihan jawaban"
            },
            {
              "jenis": "paragraf",
              "teks": "A benar karena $h = 5 m$;"
            },
            {
              "jenis": "paragraf",
              "teks": "B tidak memenuhi $tan θ$;"
            },
            {
              "jenis": "paragraf",
              "teks": "C hanya jarak mendatar;"
            },
            {
              "jenis": "paragraf",
              "teks": "D adalah sisi miring, bukan tinggi;"
            },
            {
              "jenis": "paragraf",
              "teks": "E adalah penjumlahan dua sisi dan tidak relevan."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Labeli sisi depan–samping–miring lebih dulu. Jika diketahui sudut dan jarak mendatar untuk mencari tinggi, gunakan tangen (depan/samping)."
            }
