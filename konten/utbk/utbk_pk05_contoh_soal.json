          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Dua balok sebangun mempunyai perbandingan semua ukuran panjang 1 : 2. Balok kecil memiliki ukuran panjang 6 cm, lebar 3 cm, dan tinggi 1 cm. Jika volume dan luas permukaannya masing-masing 18 cm³ dan 54 cm², manakah pernyataan yang PASTI benar mengenai balok besar?"
            }
          ],
          "opsi": {
            "A": "Volumenya 36 cm³ dan luas permukaannya 108 cm².",
            "B": "Volumenya 72 cm³ dan luas permukaannya 216 cm².",
