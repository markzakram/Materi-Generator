          "tipe": "contoh_soal",
          "judul": "Contoh Soal 12 — Luas Segitiga dalam Trapesium",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Trapesium $ABCD$ memiliki $AB$ sejajar $CD$, $AB = 14 m$, $CD = 8 m$, tinggi $6 m$. Diagonal $AC$ dan $BD$ berpotongan di $P$. Perbandingan luas segitiga $APB$ dan $CPD$ adalah ...."
            },
            {
              "jenis": "gambar",
              "file": "media/utbk_pk05_geometri_dan_pengukuran/gambar-08.png",
              "lebar": 6.56,
              "tinggi": 3.27
            }
          ],
          "opsi": {
            "A": "1 : 1",
            "B": "7 : 4",
            "C": "2 : 1",
            "D": "14 : 8",
            "E": "49 : 16"
          },
          "kunci": "E",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "**Konsep:** Segitiga $APB$ dan $CPD$ sebangun karena $AB ∥ CD$, sehingga rasio panjang yang bersesuaian adalah $14:8 = 7:4$. Rasio luas adalah kuadrat rasio panjang."
            },
            {
              "jenis": "paragraf",
              "teks": "Dari kesebangunan,"
            },
            {
              "jenis": "sorot",
              "teks": "$AP/(PC)$"
            },
            {
              "jenis": "sorot",
              "teks": "$= BP/(PD)$"
            },
            {
              "jenis": "sorot",
              "teks": "$= AB/(CD)$"
            },
            {
              "jenis": "sorot",
              "teks": "$= 7/4$"
            },
            {
              "jenis": "paragraf",
              "teks": "Luas segitiga-segitiga sebangun berbanding kuadrat skala, sehingga"
            },
            {
              "jenis": "sorot",
              "teks": "$[APB]:[CPD]$"
            },
            {
              "jenis": "sorot",
              "teks": "$= 7²:4²$"
            },
            {
              "jenis": "sorot",
              "teks": "$= 49:16.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Tinggi $6 m$ tidak diperlukan."
            },
            {
              "jenis": "subjudul",
              "teks": "Analisis pilihan"
            },
            {
              "jenis": "paragraf",
              "teks": "B dan D adalah rasio panjang, bukan luas;"
            },
            {
              "jenis": "paragraf",
              "teks": "A dan C bukan hasil pengkuadratan skala;"
            },
            {
              "jenis": "paragraf",
              "teks": "E benar."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Bila pertanyaan membandingkan LUAS dua segitiga sebangun, langsung kuadratkan rasio sisi sejajar."
            }
          ],
