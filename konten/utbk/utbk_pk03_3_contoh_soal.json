          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Sebuah percetakan membuat dua jenis paket buku, yaitu Paket A dan Paket B. Setiap Paket A membutuhkan 2 jam proses pencetakan dan 1 jam proses penjilidan, sedangkan setiap Paket B membutuhkan 1 jam proses pencetakan dan 2 jam proses penjilidan."
            },
            {
              "jenis": "paragraf",
              "teks": "Dalam satu hari, tersedia paling banyak 10 jam untuk proses pencetakan dan 8 jam untuk proses penjilidan. Jika x menyatakan banyak Paket A dan y menyatakan banyak Paket B, sistem pertidaksamaan yang sesuai adalah ...."
            }
          ],
          "opsi": {
            "A": "2x + y ≤ 10 dan x + 2y ≤ 8",
            "B": "2x + y ≥ 10 dan x + 2y ≥ 8",
            "C": "2x + y ≤ 8 dan x + 2y ≤ 10",
            "D": "x + y ≤ 10 dan 2x + 2y ≤ 8",
            "E": "2x + 2y ≤ 10 dan x + y ≤ 8"
          },
          "kunci": "A",
          "pembahasan": [
            {
              "jenis": "subjudul",
              "teks": "Konsep",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Kata **“paling banyak”** menunjukkan batas maksimum sehingga digunakan tanda **≤**."
            },
            {
              "jenis": "paragraf",
              "teks": "Waktu pencetakan:"
            },
            {
              "jenis": "poin",
              "butir": [
                "Paket A membutuhkan 2 jam → 2x",
                "Paket B membutuhkan 1 jam → y",
                "Waktu tersedia paling banyak 10 jam"
              ]
            },
            {
              "jenis": "paragraf",
              "teks": "Maka:"
            },
            {
              "jenis": "paragraf",
              "teks": "2x + y ≤ 10"
            },
            {
              "jenis": "paragraf",
              "teks": "Waktu penjilidan:"
            },
            {
              "jenis": "poin",
              "butir": [
                "Paket A membutuhkan 1 jam → x",
                "Paket B membutuhkan 2 jam → 2y",
                "Waktu tersedia paling banyak 8 jam"
              ]
            },
            {
              "jenis": "paragraf",
              "teks": "Maka:"
            },
            {
              "jenis": "paragraf",
              "teks": "x + 2y ≤ 8"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, sistem pertidaksamaan yang sesuai adalah:"
            },
            {
              "jenis": "paragraf",
              "teks": "2x + y ≤ 10"
            },
            {
              "jenis": "paragraf",
              "teks": "x + 2y ≤ 8"
            },
            {
              "jenis": "paragraf",
              "teks": "Jawaban yang benar adalah **A**."
            },
