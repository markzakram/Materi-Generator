          "judul": "Contoh Soal 2 — Evaluasi Perubahan Dimensi",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Dua balok sebangun mempunyai perbandingan semua ukuran panjang 1 : 2. Balok kecil memiliki ukuran panjang 6 cm, lebar 3 cm, dan tinggi 1 cm. Jika volume dan luas permukaannya masing-masing 18 cm³ dan 54 cm², manakah pernyataan yang PASTI benar mengenai balok besar?"
            }
          ],
          "opsi": {
            "A": "Volumenya 36 cm³ dan luas permukaannya 108 cm².",
            "B": "Volumenya 72 cm³ dan luas permukaannya 216 cm².",
            "C": "Volumenya 144 cm³ dan luas permukaannya 108 cm².",
            "D": "Volumenya 144 cm³ dan luas permukaannya 216 cm².",
            "E": "Volumenya 288 cm³ dan luas permukaannya 432 cm²."
          },
          "kunci": "D",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "**Konsep:** Kesebangunan tiga dimensi; perubahan panjang dengan faktor skala $k$ menyebabkan luas permukaan berubah dengan faktor $k^{2}$ dan volume berubah dengan faktor $k^{3}$."
            },
            {
              "jenis": "paragraf",
              "teks": "Balok kecil memiliki dimensi 6 cm × 3 cm × 1 cm sehingga volumenya:"
            },
            {
              "jenis": "sorot",
              "teks": "$V=6×3×1=18cm^{3}$"
            },
            {
              "jenis": "paragraf",
              "teks": "Luas permukaannya:"
            },
            {
              "jenis": "sorot",
              "teks": "$L=2(6×3+6×1+3×1)=54cm^{2}$"
            },
            {
              "jenis": "paragraf",
              "teks": "Karena perbandingan panjang balok kecil dan besar adalah 1 : 2, faktor skalanya $k=2$. Dimensi balok besar menjadi 12 cm × 6 cm × 2 cm."
            },
            {
              "jenis": "paragraf",
              "teks": "Volume balok besar:"
            },
            {
              "jenis": "sorot",
              "teks": "$V=18 ×2^{2}=144cm^{3}$"
            },
            {
              "jenis": "paragraf",
              "teks": "Luas permukaan balok besar:"
            },
            {
              "jenis": "sorot",
              "teks": "$L=54 ×2^{2}=216cm^{2}$"
            }
          ]
        }
