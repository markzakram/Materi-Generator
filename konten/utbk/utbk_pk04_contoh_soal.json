            {
              "jenis": "subjudul",
              "teks": "Pernyataan (1) Benar."
            },
            {
              "jenis": "paragraf",
              "teks": "Diketahui jarak awal 2 km dan pertambahan setiap pekan 0,5 km. Jarak pada pekan ke-$n$ adalah:"
            },
            {
              "jenis": "sorot",
              "teks": "$U_{n}=2+(n-1)(0,5)$"
            },
            {
              "jenis": "paragraf",
              "teks": "Ketika jarak mencapai 8 km:"
            },
            {
              "jenis": "sorot",
              "teks": "$8=2+(n-1)(0,5)$"
            },
            {
              "jenis": "sorot",
              "teks": "$6=0,5(n-1)$"
            },
            {
              "jenis": "sorot",
              "teks": "$n=13$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, jarak latihan mencapai 8 km pertama kali pada pekan ke-13."
            },
            {
              "jenis": "subjudul",
              "teks": "Pernyataan (2) Salah."
            },
