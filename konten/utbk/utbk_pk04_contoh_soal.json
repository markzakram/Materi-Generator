              "jenis": "paragraf",
              "teks": "Jarak latihan selama 13 pekan pertama membentuk deret aritmetika dengan suku pertama 2 km dan suku terakhir 8 km."
            },
            {
              "jenis": "sorot",
              "teks": "$S_{13}=(13/2)(2+8)$"
            },
            {
              "jenis": "sorot",
              "teks": "$S_{13}=65km$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, total jaraknya adalah 65 km, bukan 68 km."
            },
