          "judul": "Contoh Soal 1 — Operasi Bergantian",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Pada minggu ini, Pak Doni memetik buah mangga selama beberapa hari berturut-turut. Jumlah buah yang dipetik mengikuti pola bilangan 9, 27, 23, 69, 65, dan seterusnya. Jika pola tersebut berlanjut, berapa banyak buah mangga yang dipetik pada hari ketujuh?"
            },
            {
              "jenis": "paragraf",
              "teks": "(Jawaban ditulis dalam bentuk Angka)"
            }
          ],
          "opsi": {},
          "kunci": "",
          "pembahasan": [
            {
              "jenis": "subjudul",
              "teks": "Jawaban: 191"
            },
            {
              "jenis": "paragraf",
              "teks": "**Konsep:** Pola operasi bergantian ×3 dan −4 atau konsep dua towew"
            },
            {
              "jenis": "paragraf",
              "teks": "Diketahui barisan:"
            },
            {
              "jenis": "sorot",
              "teks": "$9, 27, 23, 69, 65,…$"
            },
            {
              "jenis": "subjudul",
              "teks": "Identifikasi arah pola"
            },
            {
              "jenis": "sorot",
              "teks": "$9↑27↓23↑69↓65$"
            },
            {
              "jenis": "paragraf",
              "teks": "Terlihat pola arah ↑ ↓ ↑ ↓, sehingga termasuk 2 Towew."
            },
            {
              "jenis": "subjudul",
              "teks": "Tentukan aturan operasinya"
            },
            {
              "jenis": "gambar",
              "file": "media/utbk_pk04_pola_dan_barisan/gambar-09.png",
              "lebar": 3.72,
              "tinggi": 0.56
            },
            {
              "jenis": "paragraf",
              "teks": "Pola operasi yang berulang adalah ×3, −4."
            },
            {
              "jenis": "subjudul",
              "teks": "Tentukan suku keenam dan ketujuh"
            },
            {
              "jenis": "gambar",
              "file": "media/utbk_pk04_pola_dan_barisan/gambar-10.png",
              "lebar": 2.45,
              "tinggi": 0.72
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, jawaban yang benar adalah E. 191."
            },
            {
              "jenis": "subjudul",
              "teks": "Analisis Pilihan Jawaban"
            },
            {
              "jenis": "paragraf",
              "teks": "A. Tidak mengikuti operasi setelah 65."
            },
            {
              "jenis": "paragraf",
              "teks": "B. Bukan hasil operasi berulang ×3 dan −4."
            },
            {
              "jenis": "paragraf",
              "teks": "C. Lebih kecil daripada hasil suku ke-7."
            },
            {
              "jenis": "paragraf",
              "teks": "D. Tidak cocok dengan pola yang sama pada seluruh data."
            },
            {
              "jenis": "paragraf",
              "teks": "E. Benar; suku ke-6 195 lalu suku ke-7 191."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Tulis operasi di atas sela antarsuku, bukan selisih semua pasangan saja."
