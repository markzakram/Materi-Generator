          "tipe": "contoh_soal",
          "judul": "Contoh Soal 1 — Kejadian Komplemen",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Sebuah kotak berisi 4 kelereng merah, 3 biru, dan 5 putih. Satu kelereng diambil secara acak. Peluang terambil kelereng yang tidak berwarna putih adalah ...."
            }
          ],
          "opsi": {
            "A": "$1/4$",
            "B": "$5/12$",
            "C": "$1/2$",
            "D": "$7/12$",
            "E": "$3/4$"
          },
          "kunci": "D",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "**Konsep:** Peluang komplemen pada ruang sampel sama mungkin."
            },
            {
              "jenis": "paragraf",
              "teks": "Total 12 kelereng;"
            },
            {
              "jenis": "paragraf",
              "teks": "selain putih ada $4+3=7$."
            },
            {
              "jenis": "paragraf",
              "teks": "$Peluang =7/12$."
            },
            {
              "jenis": "paragraf",
              "teks": "Alternatif: $1−5/12 = 7/12.$"
            },
            {
              "jenis": "sorot",
              "teks": "$P(bukan putih) = 1 − 5/12 = 7/12$"
            },
            {
              "jenis": "paragraf",
              "teks": "**Analisis pilihan:** A, B, C, E tidak menyatakan bagian 7 dari 12; D sesuai."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Cari jumlah selain putih, atau langsung 1−P(putih)."
            }
          ]
        },
        {
          "tipe": "contoh_soal",
          "judul": "Contoh Soal 2 — Pengambilan Tanpa Pengembalian",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Dari kartu bernomor 1 sampai 5 diambil dua kartu sekaligus secara acak. Peluang jumlah kedua nomor genap adalah ...."
            }
          ],
          "opsi": {
            "A": "$1/5$",
            "B": "$2/5$",
            "C": "$1/2$",
            "D": "$3/5$",
            "E": "$4/5$"
          },
          "kunci": "B",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "**Konsep:** Jumlah genap terjadi jika kedua nomor ganjil atau kedua nomor genap."
            },
            {
              "jenis": "paragraf",
              "teks": "Ada 3 kartu ganjil dan 2 kartu genap."
            },
            {
              "jenis": "paragraf",
              "teks": "Kasus menguntungkan"
            },
            {
              "jenis": "sorot",
              "teks": "$C(3,2)+C(2,2)$"
            },
            {
              "jenis": "sorot",
              "teks": "$=3+1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=4.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Total pemilihan $C(5,2)=10.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Peluang $4/10=2/5.$"
            },
            {
              "jenis": "sorot",
              "teks": "$P = [C(3, 2) + C(2, 2)]/C(5, 2) = 2/5$"
            },
            {
              "jenis": "paragraf",
              "teks": "**Analisis pilihan:** A terlalu sedikit; C, D, E lebih besar dari $4/10$; B benar."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Pisahkan kasus $ganjil+ganjil$ dan $genap+genap;$ gunakan kombinasi untuk pengambilan sekaligus."
            }
          ]
        },
        {
          "tipe": "contoh_soal",
