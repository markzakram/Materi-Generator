  "materi": [
    {
      "subbab": "Contoh Soal",
      "ikon": "checklist",
      "slide": [
        {
          "tipe": "contoh_soal",
          "judul": "Contoh Soal 1 — Relasi",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Diketahui himpunan A = {12, 18, 20, 27, 30} dan B = {2, 3, 4, 5, 6, 9, 10, 15}. Relasi R dari A ke B didefinisikan sebagai berikut:"
            },
            {
              "jenis": "paragraf",
              "teks": "x berelasi dengan y jika y merupakan faktor dari x dan hasil bagi x ÷ y merupakan bilangan prima."
            },
            {
              "jenis": "paragraf",
              "teks": "Berdasarkan relasi tersebut, perhatikan pernyataan berikut."
            },
            {
              "jenis": "paragraf",
              "teks": "(1) Pasangan (18, 9) merupakan anggota relasi R."
            },
            {
              "jenis": "paragraf",
              "teks": "(2) Pasangan (20, 5) merupakan anggota relasi R."
            },
            {
              "jenis": "paragraf",
              "teks": "(3) Range relasi R adalah {4, 6, 9, 10, 15}."
            },
            {
              "jenis": "paragraf",
              "teks": "(4) Elemen 6 pada himpunan B berelasi dengan tepat tiga elemen pada himpunan A."
            },
            {
              "jenis": "paragraf",
              "teks": "Pernyataan yang benar adalah ...."
            }
          ],
          "opsi": {
            "A": "(1), (2), dan (3) SAJA",
            "B": "(1) dan (3) SAJA",
            "C": "(2) dan (4) SAJA",
            "D": "(1), (3), dan (4) SAJA",
            "E": "SEMUA PERNYATAAN BENAR"
          },
          "kunci": "D",
          "pembahasan": [
            {
              "jenis": "subjudul",
              "teks": "Konsep",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Relasi dari himpunan A ke himpunan B merupakan hubungan yang memasangkan anggota A dengan anggota B berdasarkan aturan tertentu."
            },
            {
              "jenis": "paragraf",
              "teks": "Pada soal ini, pasangan (x, y) masuk ke dalam relasi R jika memenuhi **dua syarat sekaligus**:"
            },
            {
              "jenis": "poin",
              "butir": [
                "y merupakan faktor dari x.",
                "x ÷ y merupakan bilangan prima."
              ]
            },
            {
              "jenis": "paragraf",
              "teks": "Tentukan pasangan yang memenuhi aturan."
            },
            {
              "jenis": "paragraf",
              "teks": "Untuk x = 12:"
            },
            {
              "jenis": "paragraf",
              "teks": "12 ÷ 4 = 3 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "12 ÷ 6 = 2 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "Pasangan:"
            },
            {
              "jenis": "paragraf",
              "teks": "(12, 4), (12, 6)"
            },
            {
              "jenis": "paragraf",
              "teks": "Untuk x = 18:"
            },
            {
              "jenis": "paragraf",
              "teks": "18 ÷ 6 = 3 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "18 ÷ 9 = 2 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "Pasangan:"
            },
            {
              "jenis": "paragraf",
              "teks": "(18, 6), (18, 9)"
            },
            {
              "jenis": "paragraf",
              "teks": "Untuk x = 20:"
            },
            {
              "jenis": "paragraf",
              "teks": "20 ÷ 4 = 5 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "20 ÷ 10 = 2 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "Pasangan:"
            },
            {
              "jenis": "paragraf",
              "teks": "(20, 4), (20, 10)"
            },
            {
              "jenis": "paragraf",
              "teks": "Perhatikan bahwa:"
            },
            {
              "jenis": "paragraf",
              "teks": "20 ÷ 5 = 4"
            },
            {
              "jenis": "paragraf",
              "teks": "Karena 4 bukan bilangan prima, maka **(20, 5) bukan anggota R**."
            },
            {
              "jenis": "paragraf",
              "teks": "Untuk x = 27:"
            },
            {
              "jenis": "paragraf",
              "teks": "27 ÷ 9 = 3 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "Pasangan:"
            },
            {
              "jenis": "paragraf",
              "teks": "(27, 9)"
            },
            {
              "jenis": "paragraf",
              "teks": "Untuk x = 30:"
            },
            {
              "jenis": "paragraf",
              "teks": "30 ÷ 6 = 5 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "30 ÷ 10 = 3 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "30 ÷ 15 = 2 → prima"
            },
            {
              "jenis": "paragraf",
              "teks": "Pasangan:"
            },
            {
              "jenis": "paragraf",
              "teks": "(30, 6), (30, 10), (30, 15)"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi relasinya adalah:"
            },
            {
              "jenis": "paragraf",
              "teks": "R = {(12,4), (12,6), (18,6), (18,9), (20,4), (20,10), (27,9), (30,6), (30,10), (30,15)}"
            },
            {
              "jenis": "paragraf",
              "teks": "Sekarang periksa setiap pernyataan."
            },
            {
              "jenis": "sorot",
              "teks": "(1) (18, 9) ∈ R → Benar"
            },
            {
              "jenis": "paragraf",
              "teks": "18 ÷ 9 = 2 dan 2 merupakan bilangan prima."
            },
            {
              "jenis": "sorot",
              "teks": "(2) (20, 5) ∈ R → Salah"
            },
            {
              "jenis": "paragraf",
              "teks": "20 ÷ 5 = 4 dan 4 bukan bilangan prima."
            },
            {
              "jenis": "sorot",
              "teks": "(3) Range R = {4, 6, 9, 10, 15} → Benar"
            },
            {
              "jenis": "paragraf",
              "teks": "Anggota B yang muncul sebagai pasangan kedua adalah:"
            },
            {
              "jenis": "paragraf",
              "teks": "4, 6, 9, 10, dan 15."
            },
            {
              "jenis": "sorot",
              "teks": "(4) Elemen 6 berelasi dengan tepat tiga anggota A → Benar"
            },
            {
              "jenis": "paragraf",
              "teks": "Pasangannya adalah:"
            },
            {
              "jenis": "paragraf",
              "teks": "(12, 6), (18, 6), dan (30, 6)."
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, pernyataan yang benar adalah **(1), (3), dan (4)**."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Tidak perlu memeriksa seluruh pasangan A × B."
            },
            {
              "jenis": "paragraf",
              "teks": "Untuk setiap x, cukup cari bentuk:"
            },
            {
              "jenis": "sorot",
              "teks": "x = bilangan prima × y"
            },
            {
              "jenis": "paragraf",
              "teks": "Sehingga diperoleh:"
            },
            {
              "jenis": "paragraf",
              "teks": "12 → 4, 6"
            },
            {
              "jenis": "paragraf",
              "teks": "18 → 6, 9"
            },
            {
              "jenis": "paragraf",
              "teks": "20 → 4, 10"
            },
            {
              "jenis": "paragraf",
              "teks": "27 → 9"
            },
            {
              "jenis": "paragraf",
              "teks": "30 → 6, 10, 15"
            },
            {
              "jenis": "paragraf",
              "teks": "Dari daftar tersebut langsung terlihat:"
            },
            {
              "jenis": "paragraf",
              "teks": "(1) benar"
            },
            {
              "jenis": "paragraf",
              "teks": "(2) salah"
            },
            {
              "jenis": "paragraf",
              "teks": "(3) benar"
            },
            {
              "jenis": "paragraf",
              "teks": "(4) benar"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi jawabannya **D**."
            }
          ]
        }
      ]
    }
  ],
  "penutup": {
    "judul": "Yang Perlu Diingat",
