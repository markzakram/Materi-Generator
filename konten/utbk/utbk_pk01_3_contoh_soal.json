              "jenis": "subjudul",
              "teks": "Konsep",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Mengidentifikasi hubungan dua besaran dan menyederhanakan rasio dengan urutan yang tepat."
            },
            {
              "jenis": "paragraf",
              "teks": "Kedua jarak sudah dalam satuan yang sama, yaitu km. $Rasio pertama : kelima = 2 : 4.$ Kedua suku dibagi 2 menjadi $1 : 2$. Tidak diperlukan seluruh informasi tentang 16 pekan karena yang ditanya hanya dua pekan tertentu."
            },
            {
              "jenis": "subjudul",
              "teks": "Analisis Opsi Jawaban",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "A. Benar; 2 : 4 disederhanakan menjadi 1 : 2."
            },
            {
              "jenis": "paragraf",
              "teks": "B. Tidak sesuai dengan 2 : 4."
            },
            {
              "jenis": "paragraf",
              "teks": "C. Tidak ekuivalen dengan 2 : 4."
            },
            {
              "jenis": "paragraf",
              "teks": "D. Tidak ekuivalen dengan 2 : 4."
            },
            {
              "jenis": "paragraf",
              "teks": "E. Tidak ekuivalen dengan 2 : 4."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Ambil dua nilai yang ditanyakan, tulis sesuai urutan, lalu bagi keduanya dengan FPB."
