        {
          "tipe": "contoh_soal",
          "judul": "Contoh Soal 6 — Rasio bertingkat",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Sebuah perpustakaan menyimpan buku pada tiga rak, yaitu A, B, dan C. Perbandingan jumlah buku di rak A dan B adalah 2 : 3, sedangkan perbandingan jumlah buku di rak B dan C adalah 4 : 5. Jumlah seluruh buku pada ketiga rak tersebut adalah 140 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Pengelola perpustakaan berencana memindahkan sebagian buku antarrak tanpa mengubah jumlah keseluruhan buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Berdasarkan informasi tersebut, tentukan apakah setiap pernyataan berikut Benar atau Salah."
            },
            {
              "jenis": "tabel",
              "kolom": [
                "No.",
                "Pernyataan",
                "Benar",
                "Salah"
              ],
              "baris": [
                [
                  "1.",
                  "Jika 8 buku dipindahkan dari rak C ke rak A, jumlah buku di rak A dan B menjadi sama.",
                  "",
                  ""
                ],
                [
                  "2.",
                  "Jika 12 buku dipindahkan dari rak C ke rak B, perbandingan jumlah buku di rak B dan C menjadi 5 : 4.",
                  "",
                  ""
                ],
                [
                  "3.",
                  "Agar jumlah buku di ketiga rak sama, cukup memindahkan 8 buku dari rak C ke rak A dan 4 buku dari rak B ke rak A.",
                  "",
                  ""
                ]
              ]
            }
          ],
          "opsi": {},
          "kunci": "",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "**Jawaban: Benar, Benar, Salah**"
            },
            {
              "jenis": "paragraf",
              "teks": "**Konsep:** Menyatukan rasio bertingkat, menentukan jumlah aktual, dan menganalisis perubahan perbandingan akibat perpindahan."
            },
            {
              "jenis": "paragraf",
              "teks": "Samakan bagian B dari kedua rasio."
            },
            {
              "jenis": "paragraf",
              "teks": "A : B = 2 : 3 = 8 : 12"
            },
            {
              "jenis": "paragraf",
              "teks": "B : C = 4 : 5 = 12 : 15"
            },
            {
              "jenis": "paragraf",
              "teks": "Dengan demikian:"
            },
            {
              "jenis": "paragraf",
              "teks": "A : B : C = 8 : 12 : 15"
            },
            {
              "jenis": "paragraf",
              "teks": "Total bagian = 8 + 12 + 15 = 35."
            },
            {
              "jenis": "paragraf",
              "teks": "Nilai satu bagian = 140 ÷ 35 = 4 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Jumlah buku mula-mula adalah:"
            },
            {
              "jenis": "poin",
              "butir": [
                "Rak A = 8 × 4 = 32 buku.",
                "Rak B = 12 × 4 = 48 buku.",
                "Rak C = 15 × 4 = 60 buku."
              ]
            },
            {
              "jenis": "subjudul",
              "teks": "Pernyataan (1) Salah.",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Jika 8 buku dipindahkan dari rak C ke rak A:"
            },
            {
              "jenis": "paragraf",
              "teks": "Rak A = 32 + 8 = 40 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Rak B = 48 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Karena 40 ≠ 48, jumlah buku kedua rak tidak sama."
            },
            {
              "jenis": "subjudul",
              "teks": "Pernyataan (2) Salah.",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Jika 12 buku dipindahkan dari rak C ke rak B:"
            },
            {
              "jenis": "paragraf",
              "teks": "Rak B = 48 + 12 = 60 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Rak C = 60 − 12 = 48 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Perbandingan B : C = 60 : 48 = 5 : 4."
            },
            {
              "jenis": "paragraf",
              "teks": "Dengan demikian, pernyataan (2) Benar."
            },
            {
              "jenis": "subjudul",
              "teks": "Pernyataan (3) Salah.",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Jika 8 buku dipindahkan dari rak C ke rak A dan 4 buku dari rak B ke rak A:"
            },
            {
              "jenis": "paragraf",
              "teks": "Rak A = 32 + 8 + 4 = 44 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Rak B = 48 − 4 = 44 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Rak C = 60 − 8 = 52 buku."
            },
            {
              "jenis": "paragraf",
              "teks": "Jumlah buku ketiga rak belum sama sehingga pernyataan (3) salah."
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, urutan jawaban yang benar adalah Salah – Benar – Salah."
            },
            {
              "jenis": "catatan",
              "catatan": "tips",
              "judul": "Cara cepat",
              "teks": "Satukan rasio menjadi 8 : 12 : 15, lalu hitung jumlah buku awal (32, 48, 60). Untuk setiap pernyataan, perbarui jumlah buku pada rak yang terlibat dan periksa kembali kondisi yang diminta."
            }
          ]
        },
        {
          "tipe": "contoh_soal",
          "judul": "Contoh Soal 7 — Perubahan rasio akibat perpindahan",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Banyak siswa di kelompok A dan B mula-mula berbanding 3 : 5. Setelah 6 siswa berpindah dari kelompok B ke A, perbandingannya menjadi 1 : 1. Jumlah seluruh siswa adalah ...."
            }
          ],
          "opsi": {
            "A": "36 siswa",
            "B": "42 siswa",
            "C": "48 siswa",
            "D": "54 siswa",
            "E": "60 siswa"
          },
          "kunci": "C",
          "pembahasan": [
            {
              "jenis": "subjudul",
              "teks": "Konsep",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Menganalisis rasio sebelum dan setelah perpindahan dengan total yang tetap."
            },
            {
              "jenis": "paragraf",
              "teks": "Misalkan $A=3k$ dan $B=5k$."
            },
            {
              "jenis": "paragraf",
              "teks": "Sesudah perpindahan, $A=3k+6$ dan $B=5k−6.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Karena menjadi $1:1$, keduanya sama: $3k+6=5k−6.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi $2k=12$ dan $k=6.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Total awal $= 8k=48.$"
            },
            {
              "jenis": "paragraf",
              "teks": "Pemeriksaan: awal $A=18, B=30$; sesudah perpindahan $A=24$ dan $B=24.$"
            },
            {
              "jenis": "subjudul",
              "teks": "Analisis Opsi Jawaban",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "A. Tidak memenuhi keseimbangan sesudah perpindahan."
            },
            {
              "jenis": "paragraf",
              "teks": "B. Tidak memenuhi model $3k+6=5k−6$."
            },
            {
              "jenis": "paragraf",
              "teks": "C. Benar; 48 siswa."
            },
            {
              "jenis": "paragraf",
              "teks": "D. Total terlalu besar untuk $k=6$."
