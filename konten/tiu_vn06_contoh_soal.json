            {
              "jenis": "paragraf",
              "teks": "2.Bayu adalah satu- satunya di antara mereka yang mengikuti ekstrakurikuler paduan suara"
            },
            {
              "jenis": "paragraf",
              "teks": "3.Alya mengikuti ekstrakurikuler basket"
            },
            {
              "jenis": "paragraf",
              "teks": "4.Sukma dan Bayu sama- sama mengikuti ekstrakurikuler teater"
