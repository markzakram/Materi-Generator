        {
          "tipe": "contoh_soal",
          "judul": "Contoh Soal 1",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Sebuah segitiga memiliki alas 16 cm, tinggi 12 cm, dan dua sisi lainnya masing-masing 10 cm dan 18 cm. Tentukan luas dan keliling segitiga tersebut."
            }
          ],
          "opsi": {},
          "kunci": "",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "Dengan angka yang tertera, gunakan rumus luas segitiga terlebih dahulu. Huruf a menyatakan alas dan t menyatakan tinggi."
            },
            {
              "jenis": "sorot",
              "teks": "$L=1/2×a×t$"
            },
            {
              "jenis": "paragraf",
              "teks": "Masukkan alas 16 cm dan tinggi 12 cm."
            },
            {
              "jenis": "sorot",
              "teks": "$L=1/2×16×12$"
            },
            {
              "jenis": "sorot",
              "teks": "$L=8×12$"
            },
            {
              "jenis": "sorot",
              "teks": "$L=96 cm²$"
            },
            {
              "jenis": "paragraf",
              "teks": "Keliling diperoleh dari jumlah panjang ketiga sisi luar."
            },
            {
              "jenis": "sorot",
              "teks": "$K=a+b+c$"
            },
            {
              "jenis": "sorot",
              "teks": "$K=16+10+18$"
            },
            {
              "jenis": "sorot",
              "teks": "$K=44 cm$"
            },
            {
              "jenis": "paragraf",
              "teks": "Hasil hitung luasnya 96 cm² dan kelilingnya 44 cm. Perhatikan catatan konsistensi data berikut."
            },
            {
              "jenis": "paragraf",
              "teks": "Catatan tentang data: 96 cm² dan 44 cm adalah hasil memasukkan angka ke rumus. Data tersebut tidak membentuk segitiga yang mungkin. Jarak tegak lurus dari puncak ke garis alas tidak dapat lebih panjang daripada sisi miring yang menghubungkan puncak dengan ujung alas. Di sini, tinggi 12 cm sudah melebihi sisi 10 cm."
            }
          ]
        },
        {
          "tipe": "contoh_soal",
          "judul": "Contoh Soal 2",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Sebuah taman berbentuk lingkaran memiliki diameter 14 m. Di sekeliling taman akan dipasang pagar dengan biaya Rp75.000 per meter. Bagian dalam taman akan ditanami rumput dengan biaya Rp25.000 per m². Jika nilai π yang digunakan adalah 22 per 7, tentukan total biaya yang diperlukan."
            }
          ],
          "opsi": {},
          "kunci": "",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "Diameter taman adalah 14 m. Untuk menghitung luas, cari jari-jari terlebih dahulu."
            },
            {
              "jenis": "sorot",
              "teks": "$r=d/2$"
            },
            {
              "jenis": "sorot",
              "teks": "$r=14/2=7 m$"
            },
            {
              "jenis": "paragraf",
              "teks": "Panjang pagar mengikuti keliling lingkaran. Gunakan rumus keliling dengan diameter."
            },
            {
              "jenis": "sorot",
              "teks": "$K=πd$"
            },
            {
              "jenis": "sorot",
              "teks": "$K=22/7×14$"
            },
            {
              "jenis": "sorot",
              "teks": "$K=22×2=44 m$"
            },
            {
              "jenis": "paragraf",
              "teks": "Kalikan panjang pagar dengan tarif per meter."
            },
            {
              "jenis": "sorot",
              "teks": "$Biaya pagar=44×Rp75.000$"
            },
            {
              "jenis": "sorot",
              "teks": "$Biaya pagar=Rp3.300.000$"
            },
            {
              "jenis": "paragraf",
              "teks": "Untuk rumput, gunakan luas lingkaran dan jari-jari 7 m."
            },
            {
              "jenis": "sorot",
              "teks": "$L=πr²$"
            },
            {
              "jenis": "sorot",
              "teks": "$L=22/7×7²$"
            },
            {
              "jenis": "sorot",
              "teks": "$L=22/7×49$"
            },
            {
              "jenis": "sorot",
              "teks": "$L=22×7=154 m²$"
            },
            {
              "jenis": "paragraf",
              "teks": "Kalikan luas yang ditanami dengan tarif per meter persegi."
            },
            {
              "jenis": "sorot",
              "teks": "$Biaya rumput=154×Rp25.000$"
            },
            {
              "jenis": "sorot",
              "teks": "$Biaya rumput=Rp3.850.000$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jumlahkan biaya pagar dan biaya rumput."
            },
            {
              "jenis": "sorot",
              "teks": "$Total biaya=Rp3.300.000+Rp3.850.000$"
            },
            {
              "jenis": "sorot",
              "teks": "$Total biaya=Rp7.150.000$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, total biaya yang diperlukan adalah Rp7.150.000. Keliling dipakai pada tarif per meter, sedangkan luas dipakai pada tarif per meter persegi."
            }
          ]
        }
      ]
    }
