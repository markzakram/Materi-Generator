          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Rina menempuh perjalanan sejauh 18 km dalam waktu 1,5 jam. Kecepatan rata-rata perjalanan Rina adalah ..."
            }
          ],
          "opsi": {
            "A": "8 km/jam",
            "B": "10 km/jam",
            "C": "12 km/jam",
            "D": "14 km/jam",
            "E": "16 km/jam"
          },
          "kunci": "C",
          "pembahasan": [
            {
              "jenis": "subjudul",
              "teks": "Diketahui",
              "tingkat": 2
            },
            {
              "jenis": "sorot",
              "teks": "$Jarak (J)=18 km$"
            },
            {
              "jenis": "sorot",
              "teks": "$Waktu (W)=1,5 jam$"
            },
            {
              "jenis": "subjudul",
              "teks": "Ditanyakan",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Kecepatan rata-rata perjalanan Rina."
            },
            {
              "jenis": "subjudul",
              "teks": "Pengerjaan",
              "tingkat": 2
            },
            {
              "jenis": "gambar",
              "file": "media/tiu_nu16_jkw_jarak_kecepatan_dan_waktu/gambar-08.png",
              "lebar": 1.46,
              "tinggi": 1.25
            },
            {
              "jenis": "paragraf",
              "teks": "Gunakan segitiga JKW dan tutup K. J berada di atas W, sehingga jarak dibagi waktu."
            },
            {
              "jenis": "sorot",
              "teks": "$K=J/W$"
            },
            {
              "jenis": "sorot",
              "teks": "$=18/1,5$"
            },
            {
              "jenis": "sorot",
              "teks": "$=12 km/jam$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, kecepatan rata-rata Rina adalah 12 km/jam. Jawaban C."
            }
          ]
        },
        {
          "tipe": "contoh_soal",
          "judul": "Soal 2",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Dua buah kereta api berjalan dengan jalur yang sama dengan kecepatan rata-rata 25 dan 30 mil/jam. Jika kereta pertama berjalan satu jam lebih awal. Berapa lama waktu yang diperlukan oleh kereta kedua agar dapat menyusul kereta pertama?"
            }
          ],
          "opsi": {
            "A": "3 jam",
            "B": "4 jam",
            "C": "5 jam",
            "D": "6 jam",
            "E": "7 jam"
          },
          "kunci": "C",
          "pembahasan": [
            {
              "jenis": "subjudul",
              "teks": "Diketahui",
              "tingkat": 2
            },
            {
              "jenis": "sorot",
              "teks": "$Kecepatan 1 (K₁)=25 mil/jam$"
            },
            {
              "jenis": "sorot",
              "teks": "$Kecepatan 2 (K₂)=30 mil/jam$"
            },
            {
              "jenis": "sorot",
              "teks": "$Selisih waktu (ΔT)=1 jam$"
            },
            {
              "jenis": "subjudul",
              "teks": "Ditanyakan",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Lama waktu kereta kedua untuk menyusul, dihitung sejak kereta kedua mulai berjalan."
            },
            {
              "jenis": "subjudul",
              "teks": "Pengerjaan",
              "tingkat": 2
            },
            {
              "jenis": "tabel",
              "kolom": [
                "",
                "Searah",
                "Berlawanan Arah"
              ],
              "baris": [
                [
                  "**Berangkat Bareng**",
                  "–",
                  "$J/(K₁+K₂)$"
                ],
                [
                  "**Berangkat Tidak Bareng**",
                  "$K₂ΔT/(K₂−K₁)$",
                  "$(J+K₂·ΔT)/(K₁+K₂)$"
                ]
              ]
            },
            {
              "jenis": "paragraf",
              "teks": "Gunakan rumus searah untuk keberangkatan tidak bersamaan. W pada rumus adalah lama perjalanan kereta pertama."
            },
            {
              "jenis": "sorot",
              "teks": "$W=K₂ΔT/(K₂−K₁)$"
            },
            {
              "jenis": "sorot",
              "teks": "$=(30×1)/(30−25)$"
            },
            {
              "jenis": "sorot",
              "teks": "$=30/5$"
            },
            {
              "jenis": "sorot",
              "teks": "$=6 jam$"
            },
            {
              "jenis": "paragraf",
              "teks": "Yang ditanyakan adalah lama perjalanan kereta kedua. Kereta kedua berangkat satu jam lebih lambat, sehingga waktu bergeraknya satu jam lebih singkat."
            },
            {
              "jenis": "sorot",
              "teks": "$W kereta kedua=W−ΔT$"
            },
            {
              "jenis": "sorot",
              "teks": "$=6−1$"
            },
            {
              "jenis": "sorot",
              "teks": "$=5 jam$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jadi, kereta kedua membutuhkan 5 jam sejak mulai berjalan. Jawaban C."
            }
          ]
        },
