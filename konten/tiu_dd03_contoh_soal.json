          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Sebuah panitia akan mengangkut 40 peserta dalam satu perjalanan. Tersedia masing-masing satu kendaraan dari tiga jenis berikut."
            },
            {
              "jenis": "tabel",
              "kolom": [
                "Jenis kendaraan",
                "Kapasitas"
              ],
              "baris": [
                [
                  "A",
                  "12 orang"
                ],
                [
                  "B",
                  "20 orang"
                ],
                [
                  "C",
                  "28 orang"
                ]
              ]
            },
            {
              "jenis": "subjudul",
              "teks": "Dengan ketentuan"
            },
            {
              "jenis": "paragraf",
              "teks": "(1) Seluruh peserta harus memperoleh tempat duduk."
            },
            {
              "jenis": "paragraf",
              "teks": "(2) Jumlah kursi kosong dari seluruh kendaraan yang digunakan paling banyak 4 kursi."
            },
            {
              "jenis": "paragraf",
              "teks": "Kombinasi kendaraan yang memenuhi ketentuan tersebut adalah ...."
            }
          ],
          "opsi": {
            "A": "1 kendaraan A dan 1 kendaraan B",
            "B": "1 kendaraan A dan 1 kendaraan C",
            "C": "1 kendaraan B dan 1 kendaraan C",
            "D": "1 kendaraan A, 1 kendaraan B, dan 1 kendaraan C",
            "E": "1 kendaraan C"
          },
          "kunci": "B",
          "pembahasan": [
            {
              "jenis": "paragraf",
              "teks": "Kebutuhannya 40 kursi. Karena kursi kosong paling banyak 4, kapasitas total yang diperbolehkan adalah 40 sampai 44 kursi. Setiap jenis tersedia hanya satu kendaraan."
            },
            {
              "jenis": "paragraf",
              "teks": "A. 1 kendaraan A dan 1 kendaraan B"
            },
            {
              "jenis": "sorot",
              "teks": "$Kapasitas=12+20$"
            },
            {
              "jenis": "sorot",
              "teks": "$=32$"
            },
            {
              "jenis": "paragraf",
              "teks": "Kapasitas 32 kursi kurang dari 40. Opsi A tidak memenuhi ketentuan (1)."
            },
            {
              "jenis": "paragraf",
              "teks": "B. 1 kendaraan A dan 1 kendaraan C"
            },
            {
              "jenis": "sorot",
              "teks": "$Kapasitas=12+28$"
            },
            {
              "jenis": "sorot",
              "teks": "$=40$"
            },
            {
              "jenis": "sorot",
              "teks": "$Kursi kosong=40−40$"
            },
            {
              "jenis": "sorot",
              "teks": "$=0$"
            },
            {
              "jenis": "paragraf",
              "teks": "Seluruh peserta mendapat kursi dan tidak ada kursi kosong. Opsi B memenuhi kedua ketentuan."
            },
            {
              "jenis": "paragraf",
              "teks": "C. 1 kendaraan B dan 1 kendaraan C"
            },
            {
              "jenis": "sorot",
              "teks": "$Kapasitas=20+28$"
            },
            {
              "jenis": "sorot",
              "teks": "$=48$"
            },
            {
              "jenis": "sorot",
              "teks": "$Kursi kosong=48−40$"
            },
            {
              "jenis": "sorot",
              "teks": "$=8$"
            },
            {
              "jenis": "paragraf",
              "teks": "Kursi kosong 8 melebihi batas 4. Opsi C tidak memenuhi ketentuan (2)."
            },
            {
              "jenis": "paragraf",
              "teks": "D. 1 kendaraan A, 1 kendaraan B, dan 1 kendaraan C"
            },
            {
              "jenis": "sorot",
              "teks": "$Kapasitas=12+20+28$"
            },
            {
              "jenis": "sorot",
              "teks": "$=60$"
            },
            {
              "jenis": "sorot",
              "teks": "$Kursi kosong=60−40$"
            },
            {
              "jenis": "sorot",
              "teks": "$=20$"
            },
            {
              "jenis": "paragraf",
              "teks": "Kursi kosong 20 melebihi batas 4. Opsi D tidak memenuhi ketentuan (2)."
            },
            {
              "jenis": "paragraf",
              "teks": "E. 1 kendaraan C"
            },
            {
              "jenis": "sorot",
              "teks": "$Kapasitas=28$"
            },
            {
              "jenis": "paragraf",
              "teks": "Kapasitas 28 kursi kurang dari 40. Opsi E tidak memenuhi ketentuan (1)."
            },
            {
              "jenis": "paragraf",
              "teks": "Dengan persediaan satu unit tiap jenis, kombinasi lain yang belum tercantum hanya satu kendaraan A, satu kendaraan B, atau tidak memakai kendaraan. Semuanya berkapasitas kurang dari 40. Jadi, hanya 1 kendaraan A dan 1 kendaraan C yang memenuhi seluruh ketentuan. Jawabannya B."
            }
          ]
        },
