        {
          "tipe": "contoh_soal",
          "judul": "Soal 1",
          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Risa pergi ke festival makanan disana banyak gerai makanan dari berbagai kota yang dapat dicicipi. Di dekat pintu masuk dapat melihat gerai makanan A. Dari gerai makanan A dapat pergi ke gerai makanan B dan C. Dari gerai makanan B dapat pergi ke gerai makanan D dan E. Gerai D dan gerai E saling terhubung. Dari gerai D dapat mencicipi makanan I. Dari gerai E bisa menuju gerai I, dan H. Dari gerai C dapat mengunjungi gerai G. Gerai G terhubung dengan gerai H. Dari gerai H dan I langsung terhubung dengan gerai J yang berada di dekat pintu keluar."
            },
            {
              "jenis": "paragraf",
              "teks": "Berapa banyak rute yang dapat dilewati risa dari pintu masuk hingga pintu keluar? Jika tidak diperbolehkan mengunjungi gerai sebelumnya"
            }
          ],
          "opsi": {
            "A": "3 Rute",
            "B": "4 Rute",
            "C": "5 Rute",
            "D": "6 Rute",
            "E": "7 Rute"
          },
          "kunci": "E",
          "pembahasan": [
            {
              "jenis": "subjudul",
              "teks": "Langkah 1 — Memetakan jaringan lengkap",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Perjalanan dimulai di A dan berakhir di J. D dan E saling terhubung, sehingga keduanya dihubungkan oleh dua panah. I dapat dicapai dari D atau E, sedangkan H dapat dicapai dari E atau G. Dari H dan I, perjalanan berakhir di J."
            },
            {
              "jenis": "gambar",
              "file": "media/tiu_vn04_rute_jalur/gambar-06.png",
              "lebar": 5.97,
              "tinggi": 2.08
            },
            {
              "jenis": "subjudul",
              "teks": "Langkah 2 — Menelusuri setiap cabang awal",
              "tingkat": 2
            },
            {
              "jenis": "paragraf",
              "teks": "Dari A, mulai melalui B atau C. Melalui B, periksa D dan E secara bergantian. D bisa langsung ke I atau lewat E, sedangkan E bisa langsung ke I atau H maupun lewat D. Cabang C hanya dapat berlanjut ke G, lalu H dan J."
            },
            {
              "jenis": "subjudul",
              "teks": "Cabang A–B",
              "tingkat": 2
            },
            {
              "jenis": "sorot",
              "teks": "Rute 1. A → B → D → E → I → J"
