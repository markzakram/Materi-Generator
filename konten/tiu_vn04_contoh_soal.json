          "soal": [
            {
              "jenis": "paragraf",
              "teks": "Sebuah band musik ternama ingin mengadakan tur konser di berbagai kota, dimulai dari kota G menuju kota N. Kota G menghubungkan kota H dan I. Kota H menghubungkan kota K dan L. Kota H dan I saling terhubung. Dari Kota K & L langsung terhubung dengan kota N. Dari kota I menuju kota N perlu melewati kota M."
            },
            {
              "jenis": "paragraf",
              "teks": "Berapa banyak rute berbeda yang dapat dipilih oleh band musik tersebut? (Jika tidak diperbolehkan ke kota sebelumnya)"
            }
          ],
          "opsi": {
            "A": "2 Rute",
            "B": "3 Rute",
