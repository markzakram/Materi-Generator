      "subbab": "Sifat-sifat Operasi Hitung",
      "ikon": "roket",
      "slide": [
        {
          "tipe": "blok",
          "judul": "Sifat-sifat Operasi Hitung",
          "blok": [
            {
              "jenis": "subjudul",
              "teks": "Sifat Komutatif"
            },
            {
              "jenis": "sorot",
              "teks": "$a + b = b + a$"
            },
            {
              "jenis": "sorot",
              "teks": "$a × b = b × a$"
            },
            {
              "jenis": "subjudul",
              "teks": "Sifat Asosiatif"
            },
            {
              "jenis": "sorot",
              "teks": "$(a + b) + c = a + (b + c)$"
            },
            {
              "jenis": "sorot",
              "teks": "$(a × b) × c = a × (b × c)$"
            },
            {
              "jenis": "subjudul",
              "teks": "Sifat Distributif"
            },
            {
              "jenis": "paragraf",
              "teks": "$a × (b + c) = a × b + a × c$ atau $(b + c) × a = b × a + c × a$"
            }
          ]
        }
      ]
    },
    {
      "subbab": "Akar dan Pangkat",
      "ikon": "checklist",
      "slide": [
        {
          "tipe": "blok",
          "judul": "Akar dan Pangkat",
          "blok": [
            {
              "jenis": "subjudul",
              "teks": "Pangkat sebagai perkalian berulang"
            },
            {
              "jenis": "paragraf",
              "teks": "Pangkat adalah perkalian berulang. Misal:"
            },
            {
              "jenis": "sorot",
              "teks": "$5^{1} = 5$"
            },
            {
              "jenis": "sorot",
              "teks": "$5^{2} = 5 × 5$"
            },
            {
              "jenis": "sorot",
              "teks": "$5^{5} = 5 × 5 × 5 × 5 × 5$"
            },
            {
              "jenis": "subjudul",
              "teks": "Perkalian dan pembagian dengan bilangan pokok sama"
            },
            {
              "jenis": "sorot",
              "teks": "$a^{m} × a^{n} = a^{m+n}$"
            },
            {
              "jenis": "sorot",
              "teks": "$a^{m}/a^{n} = a^{m-n}$"
            },
            {
              "jenis": "subjudul",
              "teks": "Pangkat sama pada bilangan pokok berbeda"
            },
            {
              "jenis": "sorot",
              "teks": "$a^{n} × b^{n} = (ab)^{n}$"
            },
            {
              "jenis": "sorot",
              "teks": "$a^{n}/b^{n} = (a/b)^{n}$"
            },
            {
              "jenis": "subjudul",
              "teks": "Pangkat yang dipangkatkan lagi"
            },
            {
              "jenis": "sorot",
              "teks": "$(a^{m})^{n} = a^{mn}$"
            },
            {
              "jenis": "subjudul",
              "teks": "Pangkat nol dan pangkat negatif"
            },
            {
              "jenis": "sorot",
              "teks": "$a^{0} = 1$"
            },
            {
              "jenis": "sorot",
              "teks": "$a^{-n} = 1/a^{n}$"
            },
            {
              "jenis": "subjudul",
              "teks": "Akar sebagai kebalikan pangkat"
            },
            {
              "jenis": "paragraf",
              "teks": "Akar adalah kebalikan dari bilangan pangkat. Misal:"
            },
            {
              "jenis": "paragraf",
              "teks": "Jika $5^{2} = 25$, maka $√25 = 5$"
            },
            {
              "jenis": "paragraf",
              "teks": "Jika $2^{5} = 32$, maka $^{5}√32=2$"
            },
            {
              "jenis": "subjudul",
              "teks": "Bentuk pangkat pecahan"
            },
            {
              "jenis": "subjudul",
              "teks": "Bentuk lain akar"
            },
            {
              "jenis": "sorot",
              "teks": "$√25 = 25^{1/2}$"
            },
            {
              "jenis": "sorot",
              "teks": "$^{5}√32 = 32^{1/5}$"
            },
            {
              "jenis": "subjudul",
              "teks": "Perkalian dan pembagian akar dengan indeks sama"
            },
            {
              "jenis": "sorot",
              "teks": "$^{n}√a × ^{n}√b = ^{n}√(ab)$"
            },
            {
              "jenis": "sorot",
              "teks": "$^{n}√a/^{n}√b = ^{n}√(a/b)$"
            },
            {
              "jenis": "subjudul",
              "teks": "Penjumlahan dan pengurangan akar sejenis"
            },
            {
              "jenis": "sorot",
              "teks": "$m√a + n√a = (m + n)√a$"
            },
            {
              "jenis": "sorot",
              "teks": "$m√a - n√a = (m - n)√a$"
            },
            {
              "jenis": "subjudul",
              "teks": "Rumus Aljabar yang Wajib dihafalkan"
            },
            {
              "jenis": "sorot",
              "teks": "$a^{2} - b^{2} = (a - b)(a + b)$"
            }
          ]
        }
      ]
    }
