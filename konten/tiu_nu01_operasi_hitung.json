          "blok": [
            {
              "jenis": "paragraf",
              "teks": "Bentuk umum pecahan:"
            },
            {
              "jenis": "sorot",
              "teks": "$a/b$"
            },
            {
              "jenis": "paragraf",
              "teks": "Bentuk umum pecahan campuran:"
            },
            {
              "jenis": "sorot",
              "teks": "$a b/c$"
            },
            {
              "jenis": "subjudul",
              "teks": "Mengubah pecahan campuran menjadi pecahan biasa"
            },
            {
              "jenis": "sorot",
              "teks": "$a b/c = ((a × c) + b)/c$"
            },
            {
              "jenis": "paragraf",
              "teks": "Contoh:"
            },
            {
              "jenis": "sorot",
              "teks": "$2 4/7 = ((2 × 7) + 4)/7 = (14 + 4)/7 = 18/7$"
            },
            {
              "jenis": "subjudul",
              "teks": "Mengubah pecahan biasa menjadi pecahan campuran"
            },
            {
              "jenis": "paragraf",
              "teks": "Contoh:"
            },
            {
              "jenis": "sorot",
              "teks": "$18/7$"
            },
            {
              "jenis": "paragraf",
              "teks": "Gunakanlah pembagian:"
            },
            {
              "jenis": "gambar",
              "file": "media/tiu_nu01_operasi_hitung/gambar-01.png",
              "lebar": 5.99,
              "tinggi": 2.22
            },
            {
              "jenis": "subjudul",
              "teks": "Langkah pembagian 18 oleh 7"
            },
            {
              "jenis": "paragraf",
              "teks": "Maka"
            },
            {
              "jenis": "sorot",
              "teks": "$18/7 = 2 4/7$"
            },
            {
              "jenis": "subjudul",
              "teks": "Mengubah pecahan menjadi desimal"
            },
            {
              "jenis": "paragraf",
              "teks": "Contoh:"
            },
            {
              "jenis": "sorot",
              "teks": "$23/4$"
            },
            {
              "jenis": "paragraf",
              "teks": "Gunakanlah pembagian:"
            },
            {
              "jenis": "gambar",
              "file": "media/tiu_nu01_operasi_hitung/gambar-02.png",
              "lebar": 5.99,
              "tinggi": 3.18
            },
            {
              "jenis": "subjudul",
              "teks": "Langkah pembagian 23 oleh 4"
            },
            {
              "jenis": "paragraf",
              "teks": "Maka"
            },
            {
              "jenis": "sorot",
              "teks": "$23/4=5,75$"
            },
            {
              "jenis": "subjudul",
              "teks": "Mengubah desimal menjadi pecahan"
            },
            {
              "jenis": "paragraf",
              "teks": "Contoh: 0,17 → ada 2 angka di belakang koma"
            },
            {
              "jenis": "paragraf",
              "teks": "0,17 dikali $100 = 17$"
            },
            {
              "jenis": "sorot",
              "teks": "$0,17=17/100$"
            },
            {
              "jenis": "subjudul",
              "teks": "Pembagian pecahan"
            },
            {
              "jenis": "sorot",
              "teks": "$a/b ÷ c/d = a/b × d/c$"
            },
            {
              "jenis": "subjudul",
              "teks": "Persen"
            },
            {
              "jenis": "sorot",
              "teks": "$x% = x/100$"
            },
            {
              "jenis": "paragraf",
              "teks": "Atau"
            },
            {
              "jenis": "sorot",
              "teks": "$x/100 = x%$"
            }
          ]
        }
      ]
